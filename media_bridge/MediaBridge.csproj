<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe : pas de fenêtre de console qui clignote au lancement.
         Les flux d'entrée/sortie redirigés par Flutter fonctionnent quand même. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>media_bridge</AssemblyName>
    <RootNamespace>MediaBridge</RootNamespace>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
  </PropertyGroup>

</Project>